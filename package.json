{
  "name": "noguess",
  "version": "0.1.0",
  "description": "NoGuess M0 — deterministic synthetic fixture runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:win": "tsx --test-runner node $(Get-ChildItem -Recurse test -Filter '*.test.ts' | ForEach-Object { $_.FullName })"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  }
}
